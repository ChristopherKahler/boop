# Public address your phone will use to reach Boop (behind your HTTPS proxy).
BOOP_BASE_URL=https://boop.example.com
# Internet-reachable address monitoring services post webhooks to (/hooks/...).
# Leave blank when it is the same as BOOP_BASE_URL.
BOOP_INTAKE_URL=
# Requests a minute one webhook address accepts (default 120), and one sender
# may make to all of them (default 600). Over a limit the sender gets 429.
# 0 turns a limit off.
BOOP_HOOK_LIMIT=
BOOP_HOOK_SENDER_LIMIT=
# Days of event history to keep (0 = forever). Overrides the value saved in the web UI when set.
BOOP_RETENTION_DAYS=90
BOOP_LOG_LEVEL=info
# Timezone for monthly summaries (an IANA name such as America/Chicago). Default UTC.
BOOP_TIMEZONE=
# Name of the installed phone app on the home screen. Default Boop.
BOOP_APP_NAME=

# The login for the web UI, the phone app and the admin API. Leave both blank
# and the first start prints a one-time setup code in the log ("setup_code");
# enter it in the browser to create the login. Password: 8+ characters.
BOOP_ADMIN_USER=
BOOP_ADMIN_PASSWORD=
# true runs with no login at all. Only behind your own private proxy or VPN.
BOOP_ALLOW_NO_LOGIN=

# Bearer token for the read-only MCP endpoint (/mcp) that AI agents connect to.
# 16+ characters; leave blank to allow only device credentials / admin login.
BOOP_MCP_TOKEN=

# Web push to the installed phone app. Leave blank and the hub makes a key pair
# on first start and keeps it in its database. Set a pair (print one with
# `boop vapid`) to keep phones subscribed when you move the hub to a new database.
BOOP_VAPID_PUBLIC_KEY=
BOOP_VAPID_PRIVATE_KEY=
# Contact address push services see: mailto:you@example.com or an https URL.
# Default: BOOP_BASE_URL.
BOOP_VAPID_SUBJECT=

# Apple Push Notifications, for the optional native iOS app. Leave blank until
# you have created an APNs key; Boop runs without them.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
# Set exactly one of the two below. A non-empty APNS_PRIVATE_KEY_PATH always
# wins over APNS_PRIVATE_KEY, so leave it blank if you are pasting the key.
#
# Mounted file (the local docker-compose.yml secrets volume):
APNS_PRIVATE_KEY_PATH=
# Or paste the key, PEM text or base64 (easiest on Dokploy and other
# single-line env editors):
#   base64 -i AuthKey_XXXXXX.p8 | tr -d '\n'
APNS_PRIVATE_KEY=
# production or sandbox (use sandbox for Xcode debug builds)
APNS_ENVIRONMENT=production
